# Configuración de Backend PHP
# Copiar este archivo como .env y colocarlo junto a enviar.php en cPanel.

# API
API_KEY=MI_CLAVE_SECRETA_123

# Persistencia
# Opciones: mysql | sqlite | auto
# - mysql: recomendado para hosting cPanel. Intenta MySQL primero y si falla usa SQLite como respaldo.
# - auto: igual que mysql; alias semántico para "principal + fallback".
# - sqlite: fuerza SQLite local únicamente.
DB_DRIVER=mysql

# MySQL cPanel
# Normalmente cPanel usa nombres con prefijo de cuenta, por ejemplo:
# MYSQL_DATABASE=usuario_quotes
# MYSQL_USER=usuario_quotes_user
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=cpanel_usuario_basedatos
MYSQL_USER=cpanel_usuario_usuario
MYSQL_PASSWORD=CAMBIAR_PASSWORD
MYSQL_CHARSET=utf8mb4

# SQLite fallback/local
# Se usa como respaldo si DB_DRIVER=mysql/auto y MySQL no está disponible.
# También se usa como modo forzado cuando DB_DRIVER=sqlite.
# DB_DRIVER=sqlite
# Los datos se persisten en data/quotes.sqlite
