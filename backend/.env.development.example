# Backend PHP development config
API_KEY=DEV_API_KEY_CAMBIAR

# mysql/auto: intenta MySQL primero y usa SQLite fallback.
# sqlite: fuerza SQLite local.
DB_DRIVER=sqlite

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=dev_quotes
MYSQL_USER=dev_quotes_user
MYSQL_PASSWORD=CAMBIAR_PASSWORD
MYSQL_CHARSET=utf8mb4
