# Backend PHP production cPanel config
API_KEY=PROD_API_KEY_CAMBIAR

# mysql/auto: intenta MySQL primero y usa SQLite fallback.
# sqlite: fuerza SQLite.
DB_DRIVER=mysql

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=cpanel_usuario_basedatos
MYSQL_USER=cpanel_usuario_usuario
MYSQL_PASSWORD=CAMBIAR_PASSWORD
MYSQL_CHARSET=utf8mb4
