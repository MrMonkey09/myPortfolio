{
  "name": "myportfolio",
  "version": "1.0.0",
  "description": "Portfolio profesional con cotizador web",
  "private": true,
  "scripts": {
    "dev": "cd frontend && npm run web:dev",
    "build": "cd frontend && npm run web:build",
    "lint": "cd frontend && npm run lint",
    "api:dev": "cd frontend && npm run api:dev",
    "test:api": "cross-env NODE_OPTIONS=--experimental-vm-modules npx jest frontend/api --forceExit",
    "install:all": "npm install && cd frontend && npm install"
  },
  "dependencies": {
    "@notionhq/client": "^4.0.2",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^17.2.1",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.4.2",
    "supertest": "^7.2.2"
  }
}
