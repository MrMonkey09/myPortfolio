# Credenciales FTP
FTP_HOST=ftp.midominio.com
FTP_USER=miusuario
FTP_PASSWORD=mipassword
FTP_SECURE=false

# Rutas Remotas en cPanel
# Directorio donde se sirve el frontend
FTP_FRONTEND_DIR=/public_html
# Directorio raíz donde configuraste la aplicación PHP en cPanel
FTP_BACKEND_DIR=/api
# URL base del backend para el health check (sin trailing slash)
FTP_BACKEND_URL=https://midominio.com
